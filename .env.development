# Cesium 地图（8765 可选离线影像 CT；地形使用在线 mars3d）
# 离线底图：VITE_MAP_OFFLINE_MODE=true 且 VITE_MAP_BASE_LAYER=local
VITE_MAP_OFFLINE_MODE=false
VITE_MAP_BASE_LAYER=tianditu
VITE_MAP_TILE_SERVER_HOST=127.0.0.1
VITE_MAP_TILE_SERVER_PORT=8765
VITE_MAP_TILE_URL=http://127.0.0.1:8765/CT/{z}/{x}/{y}.png
VITE_MAP_TILE_TMS=true
VITE_MAP_TILE_PROJECTION=EPSG:4326
VITE_MAP_MIN_ZOOM=0
VITE_MAP_MAX_ZOOM=18
VITE_MAP_TERRAIN_URL=https://data.mars3d.cn/terrain
VITE_OFFLINE_MAP_SERVE_DIR=../source
VITE_MAP_TERRAIN_EXAGGERATION=1.25

